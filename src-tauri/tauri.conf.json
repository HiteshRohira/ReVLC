{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReVLC",
  "version": "0.2.8",
  "identifier": "app.revlc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ReVLC",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 450,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/thumbs/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Video",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "m4v",
          "mkv",
          "webm",
          "mov",
          "avi",
          "ts",
          "m2ts",
          "mpg",
          "mpeg",
          "wmv",
          "flv",
          "ogv",
          "3gp",
          "mts",
          "m2t",
          "vob",
          "divx",
          "rm",
          "rmvb",
          "asf",
          "f4v",
          "3g2",
          "ogm",
          "mxf"
        ],
        "name": "Video",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp3",
          "m4a",
          "aac",
          "flac",
          "wav",
          "ogg",
          "opus",
          "wma",
          "aiff",
          "mka",
          "ape",
          "wv",
          "tta",
          "mpc",
          "ac3",
          "dts",
          "oga",
          "spx",
          "m4b",
          "amr",
          "aif",
          "aifc"
        ],
        "name": "Audio",
        "role": "Viewer"
      },
      {
        "ext": [
          "m3u",
          "m3u8",
          "pls",
          "xspf",
          "asx"
        ],
        "name": "Playlist",
        "role": "Viewer"
      }
    ],
    "resources": {
      "vlc/": "vlc/",
      "../LICENSE": "licenses/LICENSE",
      "../licenses/": "licenses/"
    },
    "copyright": "Copyright (C) 2026 Hitesh Rohira. GPL-3.0-or-later. Includes libVLC (LGPL-2.1-or-later) and VLC plugins from VideoLAN.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGMDBGMkNGNjJFNjRFNTUKUldSVlR1Wml6L0lBei9CRkdPU2hqaG94ZWpZK20rcHVtbXhZNEtzRmpOTEd5WnZ3cEhGMEc5dXYK",
      "endpoints": [
        "https://revlc.vercel.app/latest.json"
      ]
    }
  }
}
