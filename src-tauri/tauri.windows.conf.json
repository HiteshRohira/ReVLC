{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ReVLC",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 450,
        "decorations": false,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "externalBin": ["binaries/ffmpeg"],
    "fileAssociations": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
