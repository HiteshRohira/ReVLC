{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ReVLC",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 450,
        "transparent": true,
        "decorations": false,
        "backgroundColor": [0, 0, 0, 0],
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": ["deb"],
    "createUpdaterArtifacts": false,
    "resources": ["../LICENSE", "../licenses/"],
    "linux": {
      "deb": {
        "depends": ["libvlc5 (>= 3.0)", "libvlccore9", "vlc-plugin-base", "vlc-plugin-video-output", "xdg-utils", "ffmpeg"]
      }
    }
  }
}
